# Przykład konfiguracji — bez prawdziwych sekretów.
# Produkcja: Node.js 24, HTTPS, dane poza kodem aplikacji.
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://TWOJA-DOMENA
DATA_DIR=/TRWALY/KATALOG/ZORZA
APP_PASSWORD_HASH=
WORKER_TOKEN=
SCHEDULER_ENABLED=1
COLLECT_INTERVAL_MINUTES=360

# Prywatny most na sieci kontenerów. Sekret ma co najmniej 32 znaki.
CHAT_BRIDGE_URL=http://chat:3001
CHAT_BRIDGE_TOKEN=

# Tylko dla usługi chat, nigdy dla przeglądarki:
CHAT_STATE_DIR=/state

# Tylko po instalacji kontrolera i zamontowaniu gniazda do app:
DEPLOY_SOCKET=/run/zorza-deploy/control.sock

# DEV_MODE=1 jest przeznaczony wyłącznie dla podglądu lokalnego.
